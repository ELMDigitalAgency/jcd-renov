# Envoi des emails du formulaire de devis via SMTP (Nodemailer).
# Le SMTP sert de relais transitaire : il envoie la demande vers la boîte
# qui reçoit les devis (CONTACT_EMAIL_TO). Ne JAMAIS committer les vraies
# valeurs — elles vivent dans les variables d'environnement Vercel.
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Adresse expéditrice (doit être le compte SMTP authentifié, IONOS l'exige)
MAIL_FROM=
MAIL_FROM_NAME=JCD Rénovation

# Boîte qui REÇOIT les demandes de devis
CONTACT_EMAIL_TO=

# Google Analytics 4 (optionnel) — si absent : aucun script, aucun bandeau cookies
NEXT_PUBLIC_GA_ID=
