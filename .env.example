# Clé API Resend (https://resend.com) — envoi des emails du formulaire de devis
# Prérequis : domaine jcd-renovation.fr vérifié dans Resend (SPF + DKIM), voir DEPLOIEMENT.md
RESEND_API_KEY=

# Adresse qui REÇOIT les demandes de devis (à valider avec le client)
CONTACT_EMAIL_TO=contact@jcd-renovation.com

# Google Analytics 4 (optionnel) — si absent : aucun script, aucun bandeau cookies
NEXT_PUBLIC_GA_ID=
